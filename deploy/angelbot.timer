# Starts the bot every weekday at 09:05 IST. The bot itself skips NSE holidays
# (config session.holidays) and exits after session.shutdown.
[Unit]
Description=Start AngelBot on weekday mornings

[Timer]
OnCalendar=Mon..Fri *-*-* 09:05:00 Asia/Kolkata
Persistent=false
Unit=angelbot.service

[Install]
WantedBy=timers.target
