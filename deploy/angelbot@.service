# systemd USER template unit. The instance name is the area: paper | live. Installed to ~/.config/systemd/user/ by deploy/setup_oci.sh.
#   systemctl --user start angelbot@paper      (live: installed but never enabled by the setup script)
[Unit]
Description=AngelBot trading bot (%i): one session per start
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/angelbot
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
# No "-" prefix on purpose: without profiles/%i.env the service refuses to start (live stays off until you create its file).
EnvironmentFile=%h/angelbot/profiles/%i.env
ExecStart=%h/angelbot/.venv/bin/python -m bot.cli run
# Restart on crashes during the session, but NOT on:
#   0 = normal end of day / kill switch, 2 = shut down with open positions (needs a human)
Restart=on-failure
RestartSec=20
RestartPreventExitStatus=2
StartLimitIntervalSec=1800
StartLimitBurst=8
# Hard stop well after market close in case anything hangs
RuntimeMaxSec=8h
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=default.target
