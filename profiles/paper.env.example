# PAPER area: real market prices, simulated orders. Secret file: copy it, fill it in, never commit it.
#   cp profiles/paper.env.example profiles/paper.env && chmod 600 profiles/paper.env
# systemd needs absolute paths. They assume the user "ubuntu" and the project in ~/angelbot: edit if yours differs.
# Comments go on their own lines (systemd does not strip a comment after a value).
ANGELBOT_PROFILE=paper
# Pinned to paper: this area can never trade live, whatever the shared .env says.
ANGELBOT_MODE=paper
ANGELBOT_RUNTIME=/home/ubuntu/angelbot/runtime/paper
ANGELBOT_CONFIG=/home/ubuntu/angelbot/config/config.yaml
# The PAPER Telegram bot (create it with @BotFather) and your chat id (from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
