# LIVE area: REAL MONEY. Prepared but OFF. Nothing here is enabled, and the service fails to start without this file.
#   cp profiles/live.env.example profiles/live.env && chmod 600 profiles/live.env
# Going live is a manual, human-only step, only after the paper phase and /preflight:
#   1. create config/config.live.yaml (stricter risk limits than paper)
#   2. add the two ANGELBOT_MODE / ANGELBOT_LIVE_CONFIRM lines below (both are needed)
#   3. enable angelbot@live.timer yourself
# Leaving the two lines out is safe: the bot then runs in paper mode inside the live folder.
ANGELBOT_PROFILE=live
ANGELBOT_RUNTIME=/home/ubuntu/angelbot/runtime/live
ANGELBOT_CONFIG=/home/ubuntu/angelbot/config/config.live.yaml
# ANGELBOT_MODE=live
# ANGELBOT_LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK
# The LIVE Telegram bot (a different bot from the paper one: two bots must never share a token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
