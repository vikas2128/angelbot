# RESEARCH area: offline replays, backtests and sample data. No broker login, no orders.
#   cp profiles/research.env.example profiles/research.env && chmod 600 profiles/research.env
# Use it through the wrapper:  ./deploy/ab research run --replay data/candles/SBIN-EQ_ONE_MINUTE.csv
ANGELBOT_PROFILE=research
ANGELBOT_MODE=paper
ANGELBOT_RUNTIME=/home/ubuntu/angelbot/runtime/research
ANGELBOT_CONFIG=/home/ubuntu/angelbot/config/config.yaml
# The TEST Telegram bot. Replays send one summary here, never one message per trade.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
