# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# NEVER commit .env. The per-area settings (mode, runtime folder, Telegram bot) live in profiles/<area>.env; see docs/ENVIRONMENTS.md. Claude Code is configured (.claude/settings.json) not to read it.

# --- Angel One SmartAPI (https://smartapi.angelone.in → My Apps → Create App) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret from "Enable TOTP" (the text under the QR code), NOT a 6-digit code
ANGEL_TOTP_SECRET=

# --- Trading mode ---
# paper = real live market data, simulated orders (default, safe)
# live  = REAL ORDERS. Requires BOTH lines below. Only after weeks of paper trading.
ANGELBOT_MODE=paper
# ANGELBOT_LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK

# --- Telegram: set per area in profiles/<area>.env, not here (one bot per area: paper, live, test) ---
# Only used by a command run outside an area, which is not recommended.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
